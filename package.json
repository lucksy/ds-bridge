{
	"name": "ds-bridge",
	"version": "1.3.0",
	"description": "Claude Code plugin connecting design-system Figma libraries to codebases: token drift, DS-aware linting, design-to-code, handoff QA",
	"type": "module",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/cli.ts",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate": "claude plugin validate . --strict",
		"check": "npm run typecheck && npm run lint && npm test && npm run validate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/culori": "^4.0.1",
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.1.8",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"culori": "^4.0.2",
		"picocolors": "^1.1.1",
		"ts-morph": "^28.0.0"
	}
}
