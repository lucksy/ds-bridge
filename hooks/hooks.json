{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-lint.mjs\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-freshness.mjs\""
					},
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-save-config.mjs\""
					}
				]
			}
		]
	},
	"modules": ["./register.tsx"]
}
