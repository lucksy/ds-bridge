# Dependencies
node_modules/

# Build output (committed only at release tags)
dist/

# Test coverage
coverage/

# Storybook's local build cache
.cache/

# Environment & secrets
.env
.env.*

# ds-bridge restart-survival dotenv (SPEC-personas §6.1) — holds the Figma PAT, so it
# must NEVER be committed and must stay out of the published plugin tarball (no `files`
# allowlist / `.npmignore`, so this line is the sole exclusion). The `.env.*` glob above
# does NOT match it (that needs a literal `.env.` prefix), hence this explicit line. The
# persist-token writer (M1.4) creates it 0600.
.ds-bridge.env

# OS noise
.DS_Store

# Logs
*.log
npm-debug.log*

# Editor
.idea/
.vscode/

# Claude Code per-machine local state (plugin enablement, etc.) — never committed
.claude/settings.local.json

# The mod API declarations Claude Code writes beside the plugin each time it loads it
# (tsconfig.mod.json reads them); regenerated per Claude Code build, never committed.
.claude-plugin/types/

# Next.js (website/)
website/.next/
website/out/
website/node_modules/

# ds-bridge CLI state (test/capture residue in this dev repo; user projects commit theirs)
.ds-bridge/
