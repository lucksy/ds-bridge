					"maximum": 100
				},
				"trend": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["date", "frames", "passing", "pct"],
						"properties": {
							"date": {
								"$ref": "#/$defs/IsoDate"
							},
							"frames": {
								"type": "number"
							},
