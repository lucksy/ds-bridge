				"total": {
					"type": "number"
				},
				"failing": {
					"type": "number"
				},
				"frames": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"key",
							"frameName",
							"points",
							"latest",
							"first",
							"delta",
							"runs",
							"passing"
						],
						"properties": {
							"key": {
								"type": "string"
							},
							"frameName": {
								"type": "string"
							},
							"fileKey": {
								"type": "string"
							},
							"nodeId": {
								"type": "string"
							},
							"points": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["date", "score"],
									"properties": {
										"date": {
											"$ref": "#/$defs/IsoDate"
										},
										"score": {
											"type": "number"
										}
									}
								}
							},
							"latest": {
								"type": "number"
							},
							"first": {
								"type": "number"
							},
							"delta": {
								"type": "number"
							},
							"runs": {
								"type": "number"
							},
							"passing": {
								"type": "boolean"
							}
						}
					}
				}
			}
		},
