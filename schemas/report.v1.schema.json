		"LibraryHotspotsTrend": {
			"type": "object",
			"description": "F3 per-component library hygiene series from the stored top-N lists (SPEC-figma-trends §3.1). A null count is unknown (below the stored top-N), never zero.",
			"required": ["dates", "rows"],
			"properties": {
				"dates": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/IsoDate"
					}
				},
				"rows": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["signal", "name", "points", "latest", "status"],
						"properties": {
							"signal": {
								"enum": ["overrides", "deprecated", "detached"]
							},
							"name": {
								"type": "string"
							},
							"points": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["date", "count"],
									"properties": {
										"date": {
											"$ref": "#/$defs/IsoDate"
										},
										"count": {
											"type": ["number", "null"]
										}
									}
								}
							},
							"first": {
								"type": "number"
							},
							"latest": {
								"type": ["number", "null"]
							},
							"delta": {
								"type": "number"
							},
							"status": {
								"enum": [
									"new",
									"rising",
									"falling",
									"flat",
									"resolved",
									"below-top"
								]
							}
						}
					}
				}
			}
		},
		"FrameReadinessTrend": {
