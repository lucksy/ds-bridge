{
	"color": {
		"$type": "color",
		"base": {
			"blue-500": {
				"$value": "#3b82f6",
				"$description": "Primary blue, mid scale"
			},
			"gray-100": { "$value": "#f3f4f6" },
			"gray-900": { "$value": "#111827" }
		},
		"brand": {
			"primary": { "$value": "{color.base.blue-500}" },
			"on-primary": { "$value": "#ffffff" },
			"surface": { "$value": "{color.base.gray-100}" }
		}
	},
	"space": {
		"$type": "dimension",
		"sm": { "$value": "8px" },
		"md": { "$value": "16px" },
		"lg": { "$value": "24px" }
	},
	"font": {
		"family": {
			"sans": {
				"$type": "fontFamily",
				"$value": "Inter, system-ui, sans-serif"
			}
		},
		"weight": {
			"regular": { "$type": "fontWeight", "$value": 400 },
			"bold": { "$type": "fontWeight", "$value": 700 }
		}
	},
	"shadow": {
		"card": {
			"$type": "shadow",
			"$description": "Resting card elevation",
			"$value": {
				"color": "#11182733",
				"offsetX": "0px",
				"offsetY": "2px",
				"blur": "8px",
				"spread": "0px"
			}
		}
	},
	"motion": {
		"duration": {
			"fast": { "$type": "duration", "$value": "150ms" }
		}
	}
}
