// Default light mode — also the base for every other light theme.
{
  base: {
    color: {
      neutral: {
        '0': { $value: { colorSpace: 'srgb', components: [1, 1, 1], hex: '#FFFFFF' }, $type: 'color' },
        '1': { $value: { colorSpace: 'hsl', components: [210, 28.6, 97.3], hex: '#F6F8FA' }, $type: 'color' },
      },
    },
  },
}
